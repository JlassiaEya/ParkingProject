{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "ServicePlaces.Services.MqttBackgroundService": "Debug"
    }
  },
  "Mqtt": {
    "Host": "localhost",
    "Port": 8883,
    "Topic": "parking/places/#",
    "ClientId": "service-places-001",
    "UseTls": true,
    "CaCertPath": "C:/certs-mqtt/ca.crt"
  },
  "RabbitMq": {
    "Host": "localhost"
  },
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://localhost:5001"
      },
      "Https": {
        "Url": "https://localhost:5443",
        "Certificate": {
          "Path": "certs/server.pfx",
          "Password": "DevPassword123"
        }
      },
      "Grpc": {
        "Url": "http://localhost:5011",
        "Protocols": "Http2"
      }
    }
  },
  "AllowedHosts": "*"
}