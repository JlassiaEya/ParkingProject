{
  "ServiceName": "Service Notifications",
  "Urls": "http://localhost:5003",
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Mqtt": {
    "Host": "localhost",
    "Port": 8883,
    "Topic": "parking/alertes/#",
    "ClientId": "service-notif-001",
    "UseTls": true,
    "CaCertPath": "C:/certs-mqtt/ca.crt"
  }
}
