{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "ParkingApi": "Information"
    },
    "Console": {
      "FormatterName": "json",
      "FormatterOptions": {
        "TimestampFormat": "yyyy-MM-dd HH:mm:ss "
      }
    }
  },
  "AllowedHosts": "*",
  "ParkingConfiguration": {
    "NombreMaxPlaces": 100,
    "NombreEtages": 3,
    "SeuilAlerteOccupation": 80
  }
}
